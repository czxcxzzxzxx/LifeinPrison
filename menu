-- The game's own report list: every player with their anticheat score
local function FetchACRows(manual)
    local remotes = GameDT.RemotesTable
    local list = remotes and remotes.ReportList
    if not list then if manual then Notify("Auto Report", "Bypass not loaded", 3) end return nil end
    local ok, rows = pcall(function() return list:InvokeServer() end)
