    function LIPUI:_clamp(panel)
        local rw, rh = self.RootW or 1280, self.RootH or 720
        local w = panel.Size.X.Offset
        local x = math.clamp(panel.Position.X.Offset, -(w - 80), rw - 80)
        local y = math.clamp(panel.Position.Y.Offset, 0, rh - TITLE_H)
        panel.Position = UDim2.fromOffset(x, y)
    end

    function LIPUI:Fit()
        local cam = workspace.CurrentCamera
        local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
        local fit = math.min((vp.X - 16) / WIN_W, (vp.Y - 16) / WIN_H)
        local s = math.clamp(math.min(fit, 1) * self.Mult, 0.4, 1.5)
        self.RootScale.Scale = s
        self.ToastScale.Scale = math.clamp(math.min(fit, 1), 0.55, 1)
        self.RootW, self.RootH = vp.X / s, vp.Y / s
        self.Root.Size = UDim2.fromOffset(self.RootW, self.RootH)
        local ts = self.ToastScale.Scale
        self.ToastRoot.Size = UDim2.fromOffset(vp.X / ts, vp.Y / ts)
        if self.Win then self:_clamp(self.Win) end
    end

    function LIPUI:SetScale(mult)
        self.Mult = math.clamp(mult, 0.5, 1.5)
        self:Fit()
    end

    function LIPUI:SetVisible(v)
        self.Visible = v and true or false
        local win = self.Win
        if self.Visible then
            self:SetEdit(false)
            self.Root.Visible = true
            tween(self.Dim, { BackgroundTransparency = DIM_T }, 0.25)
            if win then
                if self.Shifted then
                    self.Shifted = false
                    win.Position = UDim2.fromOffset(win.Position.X.Offset, self.RestY + 18)
                    pcall(function()
                        TweenService:Create(win, TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.fromOffset(win.Position.X.Offset, self.RestY) }):Play()
                    end)
                end
                tween(win, { GroupTransparency = 0 }, 0.22)
            end
            if self.TabBar then
                pcall(function()
                    TweenService:Create(self.TabBar, TweenInfo.new(0.34, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.new(0.5, 0, 0, 10) }):Play()
                end)
            end
        else
            self.Drag = nil
            self.Slide = nil
            self.Resize = nil
            self.Pending = nil
            tween(self.Dim, { BackgroundTransparency = 1 }, 0.2)
            if win then
                if not self.Shifted then
                    self.Shifted = true
                    self.RestY = win.Position.Y.Offset
                end
                tween(win, { GroupTransparency = 1 }, 0.2)
                tween(win, { Position = UDim2.fromOffset(win.Position.X.Offset, self.RestY + 18) }, 0.2)
            end
            if self.TabBar then tween(self.TabBar, { Position = UDim2.new(0.5, 0, 0, -50) }, 0.2) end
            task.delay(0.24, function()
                if not self.Visible and self.Root.Parent then self.Root.Visible = false end
