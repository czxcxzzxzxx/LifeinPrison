local function GetDataTable(fetchTimeout)
    fetchTimeout = (typeof(fetchTimeout) == "number" and fetchTimeout >= 0.5) and fetchTimeout or 15
    if GameDT.DataTable then return GameDT.DataTable end
    local startTime = tick()
    repeat
        -- 1) filtergc table search
        local ok, found = pcall(filtergc, "table", { Keys = { "CharacterInit", "CharacterAdded", "RbxPlayers", "GST" } }, true)
        if ok and typeof(found) == "table" and IsValidDataTable(found) then
            GameDT.DataTable = found
            break
        end
        -- 2) manual gc scan
        local okGc, gc = pcall(getgc, true)
        if okGc and gc then
            for _, v in ipairs(gc) do
                if typeof(v) == "table" and rawget(v, "CharacterInit") ~= nil and IsValidDataTable(v) then
                    GameDT.DataTable = v
                    break
                end
            end
        end
        if not GameDT.DataTable then task.wait(0.25) end
    until GameDT.DataTable or (tick() - startTime) >= fetchTimeout
    return GameDT.DataTable
end

-- Time encoder (GST)
local function GetTimeEncodeFuncFromDataTable(dataTable, timeout)
    local startTime = tick()
    repeat
        local gst = dataTable.GST
        if typeof(gst) == "function" and not iscclosure(gst) then
            local upvals = debug.getupvalues(gst)
            if upvals and typeof(upvals[1]) == "function" then return upvals[1] end
        end
        task.wait(0.25)
    until (tick() - startTime) >= timeout
    return nil
end

-- BClient signal
local function GetSignalIterator(signal)
    if typeof(signal) ~= "table" then return nil end
    local connFunc = rawget(signal, "Connect")
    if not IsBCFunction(connFunc) then return nil end
    local upvals = debug.getupvalues(connFunc)
    if not upvals then return nil end
    for _, v in ipairs(upvals) do
        if typeof(v) == "table" then return v end
    end
    return nil
end

local function GetSignalConnections(signal, includeDisabled)
    local result = {}
    local iter = GetSignalIterator(signal)
    while iter do
        if includeDisabled or iter.connected then table.insert(result, iter) end
        iter = iter.next
    end
    return result
end

