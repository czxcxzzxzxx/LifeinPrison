    -- Configs
    local CONFIG_DIR = CHEAT_DIR .. "/Configs"
    local INDEX_FILE = CHEAT_DIR .. "/ConfigIndex.json"
    local AUTO_FILE = CHEAT_DIR .. "/AutoLoad.txt"
    local cfgTab = win:Tab("Configs", "folder")
    local cfgList, newName = nil, ""
    local autoLoadName = nil

    local function cleanName(str)
        str = string.gsub(tostring(str or ""), "[^%w _%-]", "")
        str = string.gsub(str, "^%s+", "")
        str = string.gsub(str, "%s+$", "")
        return string.sub(str, 1, 30)
    end

    local function cfgPath(name) return CONFIG_DIR .. "/" .. name .. ".json" end

    local function readIndex()
        local out = {}
        local saved = ReadFileToTable(INDEX_FILE)
        if typeof(saved) == "table" then
            for _, name in ipairs(saved) do
                if typeof(name) == "string" and isfile(cfgPath(name)) then table.insert(out, name) end
            end
        end
        table.sort(out, function(a, b) return string.lower(a) < string.lower(b) end)
        return out
    end

    local function refreshList()
        if cfgList then cfgList:Refresh(readIndex(), autoLoadName) end
    end

    if not IsFilesystemSupported then
        cfgTab:Section("Configs")
        cfgTab:Paragraph("Not supported", "This executor has no file functions, so configs can't be saved.")
    else
        CheckFolder(CHEAT_DIR)
        CheckFolder(CONFIG_DIR)
        if isfile(AUTO_FILE) then
            local ok, content = pcall(readfile, AUTO_FILE)
            if ok then autoLoadName = cleanName(content) end
            if autoLoadName == "" or not isfile(cfgPath(autoLoadName)) then autoLoadName = nil end
        end

        -- Read every saveable control
        local function collect()
            local values = {}
            for _, key in ipairs(lib.ControlOrder) do
                local c = lib.Controls[key]
                if not c.NoSave then values[key] = c.Get() end
            end
            return values
        end

        -- Push saved values back into the controls (toasts muted while loading)
        local function apply(values)
            local n = 0
            lib.Loading = true
            for _, key in ipairs(lib.ControlOrder) do
                local c = lib.Controls[key]
                if not c.NoSave and values[key] ~= nil then
                    if pcall(c.Fire, values[key]) then n = n + 1 end
                end
            end
            lib.Loading = false
            return n
        end

        local function saveConfig(name)
            name = cleanName(name)
            if name == "" then Notify("Configs", "Type a config name first", 2) return end
            if not WriteTableToFile(cfgPath(name), { saved = os.time(), values = collect() }) then
                Notify("Configs", "Could not save " .. name, 3)
                return
            end
            local names = readIndex()
            if not table.find(names, name) then table.insert(names, name) end
            WriteTableToFile(INDEX_FILE, names)
            refreshList()
            Notify("Configs", "Saved " .. name, 2)
        end

        local function loadConfig(name, quiet)
            local data = ReadFileToTable(cfgPath(name))
            if typeof(data) ~= "table" or typeof(data.values) ~= "table" then
                Notify("Configs", "Could not read " .. name, 3)
                return
            end
            apply(data.values)
            if not quiet then Notify("Configs", "Loaded " .. name, 2) end
        end

        local function deleteConfig(name)
            pcall(delfile, cfgPath(name))
            local names = readIndex()
            local i = table.find(names, name)
            if i then table.remove(names, i) end
            WriteTableToFile(INDEX_FILE, names)
            if autoLoadName == name then
                autoLoadName = nil
                pcall(delfile, AUTO_FILE)
            end
            refreshList()
            Notify("Configs", "Deleted " .. name, 2)
        end

        local function toggleAuto(name)
            if autoLoadName == name then
                autoLoadName = nil
                pcall(delfile, AUTO_FILE)
                Notify("Configs", "Auto load off", 2)
            else
                autoLoadName = name
                pcall(writefile, AUTO_FILE, name)
                Notify("Configs", name .. " loads on start", 2)
            end
            refreshList()
        end

        cfgTab:Section("New Config")
        cfgTab:Textbox("Config name", nil, function(t) newName = t end)
        cfgTab:Button("Save Config", function() saveConfig(newName) end)
        cfgTab:Paragraph("Auto", "The config marked * loads when the menu starts.")
        cfgTab:Section("Saved Configs")
        cfgList = cfgTab:ConfigList({ Load = loadConfig, Save = saveConfig, Delete = deleteConfig, Auto = toggleAuto })
        refreshList()

        -- Load the auto config once every tab exists
        if autoLoadName then
            local name = autoLoadName
            task.delay(0.6, function() if not Unloaded then loadConfig(name, true) end end)
        end
    end

    -- Watermark: FPS, ping, AC score and what is switched on
    local wm = lib:Watermark()
    local arr = lib:ArrayList()
    local fps = 60
    Track(RunService.RenderStepped:Connect(function(dt)
        if dt > 0 then fps = fps * 0.9 + (1 / dt) * 0.1 end
    end))
    local netStats = cloneref(game:GetService("Stats"))
    local function activeFeatures()
        local list = {}
        local function add(on, name) if on then table.insert(list, name) end end
        add(AimSettings.Enabled, "Mouse Lock")
        add(SS.Enabled, "Silent Aim")
        add(Trigger.On, "Trigger Bot")
        add(ESPSettings.Enabled, "ESP")
        add(Movement.Velocity, "Velocity")
        add(Movement.Fly, "Fly")
        add(KnifeAura.On, "Knife Aura")
        add(Movement.FlyJump, "Fly Jump")
        add(CheatDT.GunModsEnabled, "Gun Mods")
        add(Rainbow.On, "Rainbow")
        add(Keycard.Auto, "Auto Keycard")
        add(AutoReport.On, "Auto Report")
        add(AutoSpec.On, "Auto Spec")
        add(SpecSettings.Enabled, "Spectating")
        add(TPSettings.ToolActive, "TP Tool")
        add(LoopSettings.SpinEnabled, "Spin")
        add(MiscSettings.AntiSit, "Anti Sit")
        return list
    end
    task.spawn(function()
        while not Unloaded do
            pcall(function()
                local ping = 0
                pcall(function() ping = netStats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
                local ac = Movement.LastScore
                wm:Set(string.format("FPS %d  |  Ping %d ms", fps, ping), ac and string.format("AC %.1f", ac) or "AC --")
                arr:Set(activeFeatures())
            end)
            task.wait(0.5)
        end
    end)

    -- Settings
    local settings = win:Tab("Settings", "settings")
    settings:Section("Overlay")
    settings:Toggle("Watermark", true, function(s) wm:SetVisible(s) end)
    settings:Toggle("Array List", true, function(s) arr:SetVisible(s) end)
    settings:Section("Privacy")
    settings:Paragraph("Usage log",
        "When the script loads it sends your Roblox username, user ID, executor name and avatar pictures to the script owner's server.")
    settings:Paragraph("Owner link",
        "While the script runs it checks in with the owner's server every few seconds (user ID, name, current game server). The owner can remotely kill, freeze, bring or kick you, send you to another server, or show a message on your screen. Nothing else is sent or run. Close the script to stop it.")
    settings:Section("Danger Zone")
    settings:Button("Fully Close", Unload)
end

-- Boot
local BootDone = false

local function Boot()
    task.delay(20, function()
        if not BootDone and not Unloaded then Report("still starting: waiting for the game to finish loading", true) end
    end)
    Splash.Step("checking access", 0.05)
    local auth = OwnerLink_Post("/access", { userid = tostring(LocalPlayer.UserId), placeid = tostring(game.PlaceId) })
    if not (auth and auth.ok == true) then
        Splash.Close()
        Report("access check failed: the server could not be reached or access is closed", true)
        getgenv().LIPMenu_LOADED = nil
        Unloaded = true
        for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
        if FOVCircle then pcall(function() FOVCircle:Remove() end) end
        return
    end
    print("[LIP Menu] step 1/3: finding BClient")
    Splash.Step("finding the game client", 0.15)
    GameDT.BClient = ReplicatedFirst:WaitForChild("BClient", 30)
    InitCheatDT()
    print("[LIP Menu] step 2/3: anticheat bypass")
    Splash.Step("loading the anticheat bypass", 0.4)

    local ok, err = pcall(AC_Load)
    if not ok then
        Splash.Close()
        Report("anticheat bypass failed: " .. tostring(err), true)
        getgenv().LIPMenu_LOADED = nil
        Unloaded = true
        for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
        if FOVCircle then pcall(function() FOVCircle:Remove() end) end
        return
    end

    EnableAntiSit() -- AntiSit defaults to on
    print("[LIP Menu] step 3/3: building the UI")
    Splash.Step("building the menu", 0.7)

    local uiOk, uiErr = pcall(StartUI)
    if not uiOk then
        Splash.Close()
        Report("UI failed: " .. tostring(uiErr), true)
        return
    end
    BootDone = true
    Splash.Step("starting features", 0.9)

    -- Leaving the game: remove every drawing so nothing stays on screen
    pcall(function() Players.PlayerRemoving:Connect(function(p) if p == LocalPlayer then ClearAllDrawings() end end) end)
    pcall(function() game.Close:Connect(ClearAllDrawings) end)
    pcall(function() LocalPlayer.AncestryChanged:Connect(function(_, parent) if not parent then ClearAllDrawings() end end) end)
    pcall(OwnerLink_Start)
    pcall(WatchListConnect) -- Staff Join Alert is on by default
    pcall(CheckWatchlistNow, true)
    task.spawn(function() pcall(SendUsageLog) end)
    Splash.Finish()
end

task.spawn(function()
    local ok, err = pcall(Boot)
    if not ok then
        BootDone = true
        Splash.Close()
        Report("startup error: " .. tostring(err), true)
        getgenv().LIPMenu_LOADED = nil
    end
end)
