-- so it works on every executor and disappears with the game when you leave
local GuiDraw = { Gui = nil }

local function GuiDrawRoot()
    if GuiDraw.Gui and GuiDraw.Gui.Parent then return GuiDraw.Gui end
    local g = Instance.new("ScreenGui")
    g.Name = "LIPMenu_ESPDraw"
    g.ResetOnSpawn = false
