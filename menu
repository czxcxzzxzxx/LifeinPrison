-- Knife Aura: sends the knife hit for nearby enemies without touching them
local KnifeAura = { On = false, Range = 10, Delay = 0.4, MaxTargets = 2, Part = "Head", TeamCheck = true,
    Swing = true, Reach = true, AutoEquip = true, Busy = false, Last = 0, Warned = false }

local function KnifeTool()
    local char = LocalPlayer.Character
    if not char then return nil end
    for _, t in ipairs(char:GetChildren()) do
        if t:IsA("Tool") and t:FindFirstChild("hitbox") then return t, t.hitbox end
    end
    return nil
end

local function KnifePart(char)
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") and d:GetAttribute("Hitbox_Melee") == true and d.Name == KnifeAura.Part then return d end
    end
    if KnifeAura.Part == "Head" then return char:FindFirstChild("Head") end
    return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
end

local function KnifeTargets(origin)
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and not (KnifeAura.TeamCheck and plr.Team ~= nil and plr.Team == LocalPlayer.Team) then
            local char = plr.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local part = hum and hum.Health > 0 and KnifePart(char)
            if part and not char:FindFirstChildOfClass("ForceField") then
                local dist = (part.Position - origin).Magnitude
                if dist <= KnifeAura.Range then table.insert(list, { part = part, dist = dist }) end
            end
        end
    end
    table.sort(list, function(a, b) return a.dist < b.dist end)
    return list
end

local function KnifeHit(tool, hitbox, root, targets, remote)
    KnifeAura.Busy = true
    if KnifeAura.Swing then pcall(function() tool:Activate() end) end
    for i = 1, math.min(KnifeAura.MaxTargets, #targets) do
        local part = targets[i].part
        if not (part.Parent and root.Parent) then break end
        local hitboxHome = hitbox.CFrame
        if KnifeAura.Reach then pcall(function() hitbox.CFrame = part.CFrame end) end
        local offset = part.CFrame:PointToObjectSpace(hitbox.Position)
        pcall(function() remote:FireServer(tool, GameDT.TimeEncode(GetFakeTime()), part, offset) end)
        if KnifeAura.Reach then pcall(function() hitbox.CFrame = hitboxHome end) end
    end
    KnifeAura.Busy = false
end

local function KnifeStep()
    if Unloaded or not KnifeAura.On then return end
    if KnifeAura.Busy or tick() - KnifeAura.Last < KnifeAura.Delay then return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not (hum and root and hum.Health > 0) then return end
    local tool, hitbox = KnifeTool()
    if not tool then
        if KnifeAura.AutoEquip then
            local pack = LocalPlayer:FindFirstChildOfClass("Backpack")
            for _, t in ipairs(pack and pack:GetChildren() or {}) do
                if t:IsA("Tool") and t:FindFirstChild("hitbox") then hum:EquipTool(t) break end
            end
        end
        return
    end
    local remotes = GameDT.RemotesTable
    local remote = remotes and remotes.OnMeleeRemote
    if not (remote and GameDT.TimeEncode) then
        if not KnifeAura.Warned then KnifeAura.Warned = true Notify("Knife Aura", "Bypass not loaded, melee remote not found", 4) end
        return
    end
    local targets = KnifeTargets(root.Position)
    if #targets == 0 then return end
    KnifeAura.Last = tick()
    task.spawn(KnifeHit, tool, hitbox, root, targets, remote)
end

Track(RunService.Heartbeat:Connect(function() pcall(KnifeStep) end))

-- Kill: grab a knife, stay behind one player and stab them; Loop Kill repeats it after every respawn
local CollectionService = cloneref(game:GetService("CollectionService"))
local Kill = { Busy = false, Cancel = false, Loop = false, Delay = 0.2, Name = "", VoidWait = 1.5 }

local function KillFindKnife()
    for _, holder in ipairs({ LocalPlayer.Character, LocalPlayer:FindFirstChild("Backpack") }) do
        if holder then
            for _, t in ipairs(holder:GetChildren()) do
                if t:IsA("Tool") and string.find(string.lower(t.Name), "knife", 1, true) and t:FindFirstChild("hitbox") then return t end
            end
        end
    end
    return nil
end

local function KillFindPickup(root)
    local best, bestD
    for _, src in ipairs(CollectionService:GetTagged("PickupSource")) do
        for _, m in ipairs(src:GetChildren()) do
            if m:IsA("Model") and (string.find(string.lower(m.Name), "knife", 1, true) or string.find(string.lower(tostring(m:GetAttribute("PickupText") or "")), "knife", 1, true)) then
                local d = (m:GetPivot().Position - root.Position).Magnitude
                if not bestD or d < bestD then best, bestD = m, d end
            end
        end
    end
    return best
end

local function KillJump(root, cf)
    if VoidTP.Enabled then
        VoidHold(root, cf.X, cf.Z)
        if not root.Parent then return end
    end
    root.AssemblyLinearVelocity = Vector3.zero
    root.CFrame = cf
end

-- gets a knife (goes to one on the map if you have none) and equips it
local function KillAcquire(hum, root, home)
    local tool = KillFindKnife()
    if not tool then
        local pickup = KillFindPickup(root)
        if not pickup then Notify("Kill", "No knife in your inventory or on the map", 4) return nil end
        local rem = GameDT.RemotesTable and GameDT.RemotesTable.ReceiveTool
        if not rem then Notify("Kill", "Bypass not loaded", 4) return nil end
        KillJump(root, pickup:GetPivot() + Vector3.new(0, 3, 0))
        for _ = 1, 6 do
            pcall(function() rem:FireServer(pickup) end)
            task.wait(0.3)
            tool = KillFindKnife()
            if tool or Kill.Cancel or Unloaded then break end
        end
        if not tool then KillJump(root, home) Notify("Kill", "Could not pick up the knife", 4) return nil end
    end
    pcall(function() hum:EquipTool(tool) end)
    task.wait(0.2)
    return tool, tool:FindFirstChild("hitbox")
end

-- returns true if the target died, false if stopped, nil on a setup error
local function KillRun(target)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = GetRoot(char)
    if not (hum and root) then Notify("Kill", "You have no character", 3) return nil end
    local home = root.CFrame
    local tool, hitbox = KillAcquire(hum, root, home)
    if not tool then return nil end
    local melee = GameDT.RemotesTable and GameDT.RemotesTable.OnMeleeRemote
    if not (hitbox and melee and GameDT.TimeEncode) then Notify("Kill", "Melee remote not found", 4) return nil end

    -- wait at home while the target is off the map or has a forcefield, strike when they are back
    local ground = RaycastParams.new()
    ground.FilterType = Enum.RaycastFilterType.Exclude
    ground.IgnoreWater = true
    ground.RespectCanCollide = true
    local function OnMap(r)
        local filter = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character then table.insert(filter, p.Character) end
        end
        ground.FilterDescendantsInstances = filter
        return workspace:Raycast(r.Position, Vector3.new(0, -600, 0), ground) ~= nil
    end

    local lastHit, striking, regrab, killed, hopping = 0, false, false, false, false
    local parked, parkedAt, struckOnce = false, 0, false
    local voidCF = CFrame.new(home.Position.X, workspace.FallenPartsDestroyHeight + 60, home.Position.Z)
    local deadline = tick() + 120
    local conn = RunService.Heartbeat:Connect(function()
        local myRoot = GetRoot(LocalPlayer.Character)
        if not myRoot or regrab or hopping then return end
        local tChar = target.Character
        local tRoot = GetRoot(tChar)
        local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
        if not (tRoot and tHum) or tHum.Health <= 0 or tChar:FindFirstChildOfClass("ForceField") or not OnMap(tRoot) then
            striking = false
            if not parked then
                parked = true
                parkedAt = tick()
                myRoot.AssemblyLinearVelocity = Vector3.zero
                myRoot.CFrame = voidCF
                myRoot.Anchored = true
            end
            return
        end
        local behind = tRoot.CFrame * CFrame.new(0, 0, 2.5)
        if parked and tick() - parkedAt < Kill.VoidWait then return end
        if not striking then
            striking = true
            struckOnce = true
            parked = false
            myRoot.Anchored = false
            myRoot.AssemblyLinearVelocity = Vector3.zero
            myRoot.CFrame = CFrame.lookAt(behind.Position, tRoot.Position)
            return
        end
        myRoot.CFrame = CFrame.lookAt(behind.Position, tRoot.Position)
        myRoot.AssemblyLinearVelocity = Vector3.zero
        if tick() - lastHit < Kill.Delay then return end
        lastHit = tick()
        local part
        for _, d in ipairs(tChar:GetDescendants()) do
            if d:IsA("BasePart") and d:GetAttribute("Hitbox_Melee") == true and d.Name == "Head" then part = d break end
        end
        part = part or tChar:FindFirstChild("Head")
        if not part then return end
        pcall(function() tool:Activate() end)
        pcall(function() hitbox.CFrame = part.CFrame end)
        local offset = part.CFrame:PointToObjectSpace(hitbox.Position)
        pcall(function() melee:FireServer(tool, GameDT.TimeEncode(GetFakeTime()), part, offset) end)
    end)
    Notify("Kill", "Going for " .. target.Name, 3)
    while tick() < deadline and not Kill.Cancel and not Unloaded do
        task.wait(0.1)
        local tHum = target.Character and target.Character:FindFirstChildOfClass("Humanoid")
        if tHum and tHum.Health <= 0 and (struckOnce or not Kill.Loop) then killed = true break end
        if hum.Health <= 0 or not target.Parent then break end
        if not regrab and not KillFindKnife() then
            -- lost the knife, grab it again
            regrab = true
            local myRoot2 = GetRoot(LocalPlayer.Character)
            if myRoot2 then
                KillJump(myRoot2, home)
                local newTool, newHitbox = KillAcquire(hum, myRoot2, home)
                if newTool then
                    tool, hitbox = newTool, newHitbox
                    if myRoot2.Parent then KillJump(myRoot2, home) end
                else
                    Kill.Cancel = true
                end
            end
            regrab = false
        elseif not regrab and tool.Parent ~= LocalPlayer.Character and KillFindKnife() == tool then
            pcall(function() hum:EquipTool(tool) end)
        end
    end
    conn:Disconnect()
    local myRoot = GetRoot(LocalPlayer.Character)
    if myRoot and hum.Health > 0 then
        if Kill.Loop and not Kill.Cancel and not Unloaded then
            if not parked then
                myRoot.AssemblyLinearVelocity = Vector3.zero
                myRoot.CFrame = voidCF
            end
            myRoot.Anchored = true
        else
            myRoot.Anchored = false
            KillJump(myRoot, home)
        end
    end
    return killed
end

function Kill.Start(target, loop)
    if Kill.Busy then Notify("Kill", "Already running. Press Stop Kill first", 3) return end
    if not target or not target.Parent then Notify("Kill", "Select a player first", 3) return end
    Kill.Busy, Kill.Cancel, Kill.Loop = true, false, loop and true or false
    task.spawn(function()
        repeat
            local ok, res = pcall(KillRun, target)
            if not ok then Notify("Kill", "Error: " .. tostring(res), 4) break end
            if res then Notify("Kill", target.Name .. " is dead", 3) end
            if not Kill.Loop or res == nil or Kill.Cancel or Unloaded then break end
            repeat
                task.wait(0.5)
                local mine = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                local theirs = target.Character and target.Character:FindFirstChildOfClass("Humanoid")
            until Kill.Cancel or Unloaded or not target.Parent or (mine and mine.Health > 0)
            if not target.Parent then Notify("Kill", target.Name .. " left the game", 3) break end
            task.wait(1)
        until Kill.Cancel or Unloaded
        Kill.Busy = false
        if Kill.Cancel then Notify("Kill", "Stopped", 2) end
        if Kill.Obj then Kill.Obj:Set(false) end
    end)
end

function Kill.Stop()
    Kill.Cancel = true
    Kill.Loop = false
end

local function Unload()
    if Unloaded then return end
    Unloaded = true
    Kill.Stop()
    CheatDT.GunModsEnabled = false
    OwnerLink.Frozen = false
    pcall(function() local r = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") if r then r.Anchored = false end end)
    Rainbow.On = false
    pcall(Rainbow.Restore)
    Movement.Velocity, Movement.Fly, Movement.FlyJump = false, false, false
    pcall(Music.Stop)
    TPSettings.ToolActive = false
    pcall(CleanUpTool)
    Silent.S.Enabled = false
    Silent.Restore()
    Turret.On = false
    KnifeAura.On = false
    NoDoors.On = false
    pcall(NoDoors.Restore)
    pcall(Turret.Restore)
    if Silent.Gui then Silent.Gui:Destroy() Silent.Gui = nil end
    AimSettings.Enabled = false
    pcall(function() RunService:UnbindFromRenderStep("LIPMenu_Aim") end)
    MiscSettings.AntiHeadsit = false
    for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
    if WatchList.Connection then WatchList.Connection:Disconnect() end
    ClearAllDrawings()
    DisableAntiSit()
    CleanUpTool()
    local char = LocalPlayer.Character
    local ff = char and char:FindFirstChild("AntiHeadsitFF")
    if ff then ff:Destroy() end
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then workspace.CurrentCamera.CameraSubject = hum end
    getgenv().LIPMenu_LOADED = nil
    if lib then pcall(function() lib:Destroy() end) end
end

