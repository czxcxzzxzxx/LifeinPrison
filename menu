local function Report(msg, toast)
    print("[LIP Menu] " .. msg)
    if toast then
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", { Title = "LIP Menu", Text = msg, Duration = 8 })
        end)
    end
end

Report("script started")

local IsFilesystemSupported = true

local function LdrCheckExecutor()
    if not identifyexecutor then Report("executor has no identifyexecutor - cannot continue", true) return false end
    local execName = identifyexecutor()
    if execName ~= "Volt" then print("[LIP Menu] Recommended executor: Volt (detected: " .. tostring(execName) .. ")") end
    local required = {
        "getgenv", "getconnections", "cloneref", "compareinstances", "iscclosure", "hookfunction",
        "newcclosure", "getgc", "filtergc",
    }
    for _, name in ipairs(required) do
        local fn = (getgenv and getgenv()[name]) or nil
        if typeof(fn) ~= "function" then
            Report("executor is missing: " .. name, true)
            return false
        end
    end
    if typeof(debug) ~= "table" or not (debug.getinfo and debug.getconstants and debug.getupvalue and debug.getupvalues) then
        Report("executor is missing debug library functions", true)
        return false
    end
    for _, name in ipairs({ "readfile", "writefile", "isfolder", "isfile", "delfile", "makefolder" }) do
        if typeof(getgenv()[name]) ~= "function" then IsFilesystemSupported = false end
    end
    return true
end

