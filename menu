local Keycard = { Auto = false, Busy = false, Cooldown = 0 }

do
    local CollectionService = cloneref(game:GetService("CollectionService"))

    local function IsKeycardName(n) n = string.lower(tostring(n or "")) return string.find(n, "keycard", 1, true) or string.find(n, "key card", 1, true) end
    function Keycard.Has()
        for _, holder in ipairs({ LocalPlayer:FindFirstChild("Backpack"), LocalPlayer.Character }) do
            if holder then
                for _, t in ipairs(holder:GetChildren()) do
                    if t:IsA("Tool") and IsKeycardName(t.Name) then return true end
                end
            end
        end
        return false
    end

    function Keycard.List()
        local out = {}
        for _, src in ipairs(CollectionService:GetTagged("PickupSource")) do
            for _, m in ipairs(src:GetChildren()) do
                if m:IsA("Model") and (IsKeycardName(m.Name) or IsKeycardName(m:GetAttribute("PickupText"))) then out[#out + 1] = m end
            end
        end
        return out
    end

    function Keycard.Pickup(manual)
        if Keycard.Busy then return end
        if Keycard.Has() then
            if manual then Notify("Keycard", "Already have one", 3) end
            return
        end
        local char = LocalPlayer.Character
        local hrp = GetRoot(char)
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return end
        local best, bestD
        for _, m in ipairs(Keycard.List()) do
            local d = (m:GetPivot().Position - hrp.Position).Magnitude
            if not bestD or d < bestD then best, bestD = m, d end
        end
        if not best then
            if manual then Notify("Keycard", "No keycard found", 3) end
            return
        end
        local remotes = GameDT.RemotesTable
        local rem = remotes and remotes.ReceiveTool
        if not rem or typeof(rem.FireServer) ~= "function" then
            if manual then Notify("Keycard", "Bypass not loaded", 4) end
            return
        end
        Keycard.Busy = true
        local back = hrp.CFrame
        local moved = bestD > 6
        if moved then hrp.CFrame = CFrame.new(best:GetPivot().Position + Vector3.new(0, 2, 0)) end
        local stop = tick() + 1.5
        repeat
            pcall(function() rem:FireServer(best) end)
            task.wait(0.25)
        until Keycard.Has() or tick() > stop or Unloaded or not best.Parent
        if moved and hrp.Parent then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.CFrame = back
        end
        local got = Keycard.Has()
        Keycard.Busy = false
        if not got then Keycard.Cooldown = tick() + 10 end
        if manual or got then Notify("Keycard", got and "Picked up a keycard" or "Pickup failed", 3) end
    end
    task.spawn(function()
        while not Unloaded do
            task.wait(1.5)
            if Keycard.Auto and tick() > Keycard.Cooldown then pcall(Keycard.Pickup, false) end
        end
    end)
end

