local ESPState = setmetatable({}, { __mode = "k" })

local function ESPHide(o)
    local st = ESPState[o]
    if not st then st = {} ESPState[o] = st end
    if st.Hidden then return end
    st.Hidden = true
    for key, obj in pairs(o) do
        if key == "Highlight" then
            obj.Enabled = false
            obj.Adornee = nil
        elseif key == "Bones" then
            for _, line in ipairs(obj) do line.Visible = false end
        else
            obj.Visible = false
        end
    end
end

local function CleanESPForPlayer(player)
    local o = ESPObjects[player]
    if not o then return end
    for key, obj in pairs(o) do
        if key == "Highlight" then
            pcall(function() obj:Destroy() end)
        elseif key == "Bones" then
            for _, line in ipairs(obj) do pcall(function() line:Remove() end) end
        else
            pcall(function() obj:Remove() end)
        end
    end
    ESPObjects[player] = nil
end

local function ClearAllDrawings()
    for player in pairs(ESPObjects) do CleanESPForPlayer(player) end
    if FOVCircle then pcall(function() FOVCircle.Visible = false end) end
    for _, d in ipairs(getgenv().LIPMenu_Drawings or {}) do pcall(function() d:Remove() end) end
    getgenv().LIPMenu_Drawings = {}
    if ESPGui then pcall(function() ESPGui:Destroy() end) ESPGui = nil end
    if GuiDraw.Gui then pcall(function() GuiDraw.Gui:Destroy() end) GuiDraw.Gui = nil end
end

local function ESPColor(player)
    if ESPSettings.TeamColors and player.Team and player.TeamColor then return player.TeamColor.Color end
    return ESP_DEFAULT_COLOR
end

local function ESPSkeleton(o, char, cam, color)
    local st = ESPState[o]
    if not st then st = {} ESPState[o] = st end
    if not ESPSettings.Skeleton then
        if st.SkelOn then
            st.SkelOn = false
            for _, line in ipairs(o.Bones) do line.Visible = false end
        end
        return
    end
    st.SkelOn = true
    local parts = st.SkelParts
    if st.SkelChar ~= char or not parts then
        parts = {}
        local rig = char:FindFirstChild("UpperTorso") and R15Bones or R6Bones
        for i = 1, #o.Bones do
            local pair = rig[i]
            local a = pair and char:FindFirstChild(pair[1])
            local b = pair and char:FindFirstChild(pair[2])
            if a and b then parts[i] = { a, b } end
        end
        st.SkelChar, st.SkelParts = char, parts
    end
    local lastColor = st.SkelColor
    for i, line in ipairs(o.Bones) do
        local pair = parts[i]
        if pair and pair[1].Parent and pair[2].Parent then
            local pa, va = cam:WorldToViewportPoint(pair[1].Position)
            local pb, vb = cam:WorldToViewportPoint(pair[2].Position)
            if va and vb then
                line.From = Vector2.new(pa.X, pa.Y)
                line.To = Vector2.new(pb.X, pb.Y)
                if lastColor ~= color then line.Color = color end
                line.Visible = true
            else
                line.Visible = false
            end
        else
            line.Visible = false
            if pair then st.SkelParts = nil end
        end
    end
    st.SkelColor = color
end

local ESPErrorShown = false

local function UpdateESP()
    -- leaving the game: take every drawing off the screen
    if not LocalPlayer.Parent then ClearAllDrawings() return end
    if not ESPSettings.Enabled then
        if next(ESPObjects) then for player in pairs(ESPObjects) do CleanESPForPlayer(player) end end
        return
    end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local viewport = cam.ViewportSize

    for player in pairs(ESPObjects) do
        if not player.Parent then CleanESPForPlayer(player) end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        repeat
        if player == LocalPlayer then break end
        local o = ESPObjects[player] or ESPCreate(player)

        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local valid = hrp and head and hum and hum.Health > 0
        if valid and ESPSettings.TeamCheck and player.Team ~= nil and player.Team == LocalPlayer.Team then valid = false end

        if not valid then
            ESPHide(o)
            break
        end

        local color = ESPColor(player)
        local st = ESPState[o]
        if not st then st = {} ESPState[o] = st end
        st.Hidden = false

        local hl = o.Highlight
        if ESPSettings.Chams then
            if hl.Adornee ~= char then hl.Adornee = char end
            if st.HlColor ~= color then hl.FillColor = color st.HlColor = color end
            if not hl.Enabled then hl.Enabled = true end
        elseif hl.Enabled then
            hl.Enabled = false
        end

        local rootPos, onScreen = cam:WorldToViewportPoint(hrp.Position)
        if not onScreen then
            o.Box.Visible = false o.BoxOutline.Visible = false o.Name.Visible = false o.Dist.Visible = false
            o.HealthBG.Visible = false o.HealthBar.Visible = false o.Tracer.Visible = false
            for _, line in ipairs(o.Bones) do line.Visible = false end
            break
        end

        local top = cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.7, 0))
        local bottom = cam:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
        local height = math.abs(bottom.Y - top.Y)
        local width = height / 1.6
        local x = rootPos.X - width / 2
        local y = top.Y

        o.Box.Visible = ESPSettings.Boxes
        o.BoxOutline.Visible = ESPSettings.Boxes
        if ESPSettings.Boxes then
            o.Box.Size = Vector2.new(width, height)
            o.Box.Position = Vector2.new(x, y)
            o.Box.Color = color
            o.BoxOutline.Size = o.Box.Size
            o.BoxOutline.Position = o.Box.Position
        end

        o.Name.Visible = ESPSettings.Names
        if ESPSettings.Names then
            local nameText, nameColor
            if WatchList.UserIds[player.UserId] then
                local owner = OwnerIds[player.UserId]
                nameText = (owner and "[OWNER] " or "[MODERATOR] ") .. player.DisplayName
                nameColor = owner and Color3.fromRGB(255, 200, 40) or Color3.fromRGB(255, 60, 60)
            else
                nameText = player.DisplayName
                nameColor = Color3.new(1, 1, 1)
            end
            if st.NameText ~= nameText then o.Name.Text = nameText st.NameText = nameText end
            if st.NameColor ~= nameColor then o.Name.Color = nameColor st.NameColor = nameColor end
            o.Name.Position = Vector2.new(rootPos.X, y - 16)
        end

        o.Dist.Visible = ESPSettings.Distance
        if ESPSettings.Distance then
            local distText = string.format("[%d studs]", (cam.CFrame.Position - hrp.Position).Magnitude)
            if st.DistText ~= distText then o.Dist.Text = distText st.DistText = distText end
            o.Dist.Position = Vector2.new(rootPos.X, y + height + 2)
        end

        o.HealthBG.Visible = ESPSettings.Health
        o.HealthBar.Visible = ESPSettings.Health
        if ESPSettings.Health then
            local pct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
            local bx = x - 5
            o.HealthBG.From = Vector2.new(bx, y + height + 1)
            o.HealthBG.To = Vector2.new(bx, y - 1)
            o.HealthBar.From = Vector2.new(bx, y + height)
            o.HealthBar.To = Vector2.new(bx, y + height - height * pct)
            o.HealthBar.Color = Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(0, 255, 0), pct)
        end

        o.Tracer.Visible = ESPSettings.Tracers
        if ESPSettings.Tracers then
            local originY = viewport.Y
            if ESPSettings.TracerOrigin == "Top" then
                originY = 0
            elseif ESPSettings.TracerOrigin == "Center" then
                originY = viewport.Y / 2
            end
            o.Tracer.From = Vector2.new(viewport.X / 2, originY)
            o.Tracer.To = Vector2.new(rootPos.X, y + height)
            o.Tracer.Color = color
        end

        ESPSkeleton(o, char, cam, color)
        until true
    end
end

