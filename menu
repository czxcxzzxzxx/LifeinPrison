-- Spectates a player the first time their score reaches the minimum
function AutoSpec.Check(rows)
    for _, row in ipairs(rows) do
        local plr, score = row.Player, tonumber(row.Score)
        if plr and plr ~= LocalPlayer and score then
            if score < AutoSpec.Min then
                AutoSpec.Done[plr] = nil
            elseif not AutoSpec.Done[plr] then
                AutoSpec.Done[plr] = true
                SpecSettings.Name = plr.Name
                SpecSettings.Target = plr
                SpecSettings.Enabled = true
                local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
                if hum then workspace.CurrentCamera.CameraSubject = hum end
                if SpecSettings.ToggleObj then SpecSettings.ToggleObj:Set(true) end
                if SpecSettings.StatusObj then SpecSettings.StatusObj:Set("Spectating: " .. plr.Name) end
                Notify("Auto Spectate", string.format("%s reached %d AC points", plr.Name, score), 5)
                break
            end
        end
    end
end

function AutoReport.Run(manual, rows)
    local remotes = GameDT.RemotesTable
    local report = remotes and remotes.Report
    if not report then if manual then Notify("Auto Report", "Bypass not loaded", 3) end return end
    rows = rows or FetchACRows(manual)
    if not rows then return end
    local count = 0
    for _, row in ipairs(rows) do
        local plr, score = row.Player, tonumber(row.Score)
        if plr and plr ~= LocalPlayer and score and score >= AutoReport.Min and tick() - (AutoReport.Done[plr] or -1e9) > 600 then
            AutoReport.Done[plr] = tick()
            pcall(function() report:FireServer(plr) end)
            count = count + 1
            Notify("Auto Report", string.format("%s (%.1f)", plr.Name, score), 3)
            task.wait(1.5)
        end
    end
    if manual and count == 0 then Notify("Auto Report", "Nobody at or above " .. AutoReport.Min, 3) end
end

task.spawn(function()
    while not Unloaded do
        task.wait(3)
        if AutoReport.On or AutoSpec.On or Movement.ScoreObj then
            local rows = FetchACRows(false)
            if rows then
                pcall(Movement.UpdateScore, rows)
                if AutoSpec.On then pcall(AutoSpec.Check, rows) end
                if AutoReport.On then pcall(AutoReport.Run, false, rows) end
            end
        end
    end
end)

