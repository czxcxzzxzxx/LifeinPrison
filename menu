            cr.CornerRadius = UDim.new(0, 0)
            cr.Parent = bar
            local head = label(b, title, 13, TEXT, { Position = UDim2.fromOffset(12, 4), Size = UDim2.new(1, -24, 0, 20) })
            for i, item in ipairs(items) do
                local ok = hasAny(item)
                if ok then passed = passed + 1 end
                label(b, item[1], 12, ok and GREEN or RED, { Position = UDim2.fromOffset(12, 32 + (i - 1) * 19), Size = UDim2.new(1, -24, 0, 18) })
            end
            head.Text = title .. " (" .. passed .. "/" .. #items .. ")"
            return passed, #items
        end

