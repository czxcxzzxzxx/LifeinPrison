            for _, c in ipairs(results:GetChildren()) do
                if c ~= summary then c:Destroy() end
            end
            local w1, h1 = measure("required", required)
            local w2, h2 = measure("optional", optional)
            local h = math.max(h1, h2)
            local rp, rt = box(8, w1, h, "required", required)
            local op, ot = box(16 + w1, w2, h, "optional", optional)
            if rp == rt then
                summary.Text = "all required functions are supported"
                summary.TextColor3 = GREEN
            else
                summary.Text = "missing " .. (rt - rp) .. " required function(s): the script will not load on this executor"
                summary.TextColor3 = RED
            end
            -- window fits the boxes and the summary line
            local sumW = textWidth(summary.Text, 12) + 24
