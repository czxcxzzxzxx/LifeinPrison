local function ClearMenuScreen(duration)
    local Lighting = cloneref(game:GetService("Lighting"))
    local seen = {}
    for _, c in ipairs(AC_GetConnections(RunService.RenderStepped)) do seen[c.Function] = true end
    local stop = tick() + duration
    while tick() < stop and not Unloaded do
        local char = LocalPlayer.Character
