        local function textWidth(str, size)
            local w = #str * (size * 0.6)
            pcall(function() w = TextService:GetTextSize(str, size, font, Vector2.new(1000, 100)).X end)
            return w
        end

        -- Box sized to its text: width from the longest name, height from the row count
        local function measure(title, items)
            local w = textWidth(title .. " (00/00)", 13)
            for _, item in ipairs(items) do w = math.max(w, textWidth(item[1], 12)) end
            return math.ceil(w) + 24, 36 + #items * 19 + 6
        end

