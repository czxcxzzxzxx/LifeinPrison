-- Trigger Bot
local Trigger = { On = false, Delay = 0.05, TeamCheck = true, HeadOnly = false, MaxDistance = 1000, Method = "Tool Activate" }

do
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true
    local lastShot, firing, pressed = 0, nil, false

    local function Release()
        if firing then pcall(function() firing:Deactivate() end) firing = nil end
        if pressed then
            pressed = false
            if typeof(mouse1release) == "function" then pcall(mouse1release) end
        end
    end

    -- Ray from the cursor that skips invisible / non-solid parts, so only real cover blocks it
    local function CursorHit(origin, dir, char)
        local ignore = { char }
        for _ = 1, 8 do
            params.FilterDescendantsInstances = ignore
            local hit = workspace:Raycast(origin, dir, params)
            if not hit then return nil end
            local inst = hit.Instance
            local model = inst:FindFirstAncestorOfClass("Model")
            if (model and Players:GetPlayerFromCharacter(model)) or (inst.CanCollide and inst.Transparency < 0.95) then return hit end
            table.insert(ignore, inst)
        end
        return nil
    end

    Track(RunService.Heartbeat:Connect(function()
        if not Trigger.On or Unloaded then return Release() end
        local char = LocalPlayer.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        local cam = workspace.CurrentCamera
        if not tool or not cam then return Release() end
        local o = GetAimOrigin()
        local ray = cam:ViewportPointToRay(o.X, o.Y)
        local hit = CursorHit(ray.Origin, ray.Direction * Trigger.MaxDistance, char)
        local valid = false
        if hit then
            local model = hit.Instance:FindFirstAncestorOfClass("Model")
            local plr = model and Players:GetPlayerFromCharacter(model)
            local hum = model and model:FindFirstChildOfClass("Humanoid")
            if plr and plr ~= LocalPlayer and hum and hum.Health > 0 and not model:FindFirstChildOfClass("ForceField")
                and not (Trigger.TeamCheck and plr.Team ~= nil and plr.Team == LocalPlayer.Team)
                and (not Trigger.HeadOnly or hit.Instance.Name == "Head") then
                valid = true
            end
        end
        if not valid then return Release() end

        if Trigger.Method == "Mouse Click" and typeof(mouse1press) == "function" then
            if not pressed then
                pressed = true
                pcall(mouse1press)
            end
            return
        end
        local now = tick()
        if now - lastShot >= Trigger.Delay then
            lastShot = now
            firing = tool
            pcall(function() tool:Activate() end)
        end
    end))
end

-- Movement: velocity speed, fly and fly jump (physics based, with a wall guard)
local Movement = { Velocity = false, VelSpeed = 50, Fly = false, FlySpeed = 50, MaxSpeed = 200, FlyJump = false, WallGuard = true, Blocked = false, ScoreObj = nil, Alerts = true, LastScore = nil, Scores = {} }

do
    local wallParams = RaycastParams.new()
    wallParams.FilterType = Enum.RaycastFilterType.Exclude
    wallParams.IgnoreWater = true
    wallParams.RespectCanCollide = true

    local LOOK_AHEAD = 0.18 -- seconds of travel to look ahead
    local HEIGHTS = { -1.5, 0, 1.5 } -- knee, waist, head
    local FilterAt, FilterChar = 0, nil

    -- Slows you down before a wall so you never cross one (crossing walls is what the anticheat punishes hardest)
    local function AllowedSpeed(char, hrp, dir, wanted)
        local now = os.clock()
        if now - FilterAt > 0.5 or FilterChar ~= char then
            local filter = { char }
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr.Character and plr.Character ~= char then filter[#filter + 1] = plr.Character end
            end
            wallParams.FilterDescendantsInstances = filter
            FilterAt, FilterChar = now, char
        end

        -- distance kept from the thing ahead: floors need your body height, ceilings your head
        local standoff = 2.2
        if dir.Y < -0.3 then standoff = 3.2 elseif dir.Y > 0.3 then standoff = 2.6 end

        local reach = math.min(wanted * LOOK_AHEAD, 40) + standoff
        local nearest
        for _, h in ipairs(HEIGHTS) do
            local hit = workspace:Raycast(hrp.Position + Vector3.new(0, h, 0), dir * reach, wallParams)
            if hit then
                -- floors only count when you are moving down, ceilings only when moving up
                local ny = hit.Normal.Y
                local blocks = true
                if ny > 0.7 and dir.Y > -0.3 then blocks = false end
                if ny < -0.7 and dir.Y < 0.3 then blocks = false end
                if blocks and (not nearest or hit.Distance < nearest) then nearest = hit.Distance end
            end
        end
        if not nearest then return wanted, false end
        return math.min(wanted, math.max(nearest - standoff, 0) / LOOK_AHEAD), true
    end

    local function FlyDirection()
        local cam = workspace.CurrentCamera
        local down = function(k) return UserInputService:IsKeyDown(k) end
        local d = Vector3.zero
        if down(Enum.KeyCode.W) then d = d + cam.CFrame.LookVector end
        if down(Enum.KeyCode.S) then d = d - cam.CFrame.LookVector end
        if down(Enum.KeyCode.D) then d = d + cam.CFrame.RightVector end
        if down(Enum.KeyCode.A) then d = d - cam.CFrame.RightVector end
        if down(Enum.KeyCode.Space) then d = d + Vector3.yAxis end
        if down(Enum.KeyCode.LeftShift) or down(Enum.KeyCode.LeftControl) then d = d - Vector3.yAxis end
        return d
    end

    local function Step()
        if not (Movement.Velocity or Movement.Fly) or Unloaded then return end
        AntiPhysicsCache.SelfMove = os.clock()
        if UserInputService:GetFocusedTextBox() then return end
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = hum and hum.RootPart
        if not hrp or hum.Health <= 0 or hum.Sit then return end

        if Movement.Fly then
            local dir = FlyDirection()
            if dir.Magnitude < 0.01 then
                hrp.AssemblyLinearVelocity = Vector3.zero -- hover
                Movement.Blocked = false
                return
            end
            dir = dir.Unit
            local speed = math.min(Movement.FlySpeed, Movement.MaxSpeed)
            Movement.Blocked = false
            if Movement.WallGuard then
                local allowed, hit = AllowedSpeed(char, hrp, dir, speed)
                if hit then Movement.Blocked = allowed < speed speed = allowed end
            end
            hrp.AssemblyLinearVelocity = dir * speed
            return
        end

        -- Velocity speed: physics moves you along the direction you are walking
        local move = hum.MoveDirection
        if move.Magnitude < 0.01 then Movement.Blocked = false return end
        local dir = Vector3.new(move.X, 0, move.Z).Unit
        local speed = math.min(Movement.VelSpeed, Movement.MaxSpeed)
        Movement.Blocked = false
        if Movement.WallGuard then
            local allowed, hit = AllowedSpeed(char, hrp, dir, speed)
            if hit then Movement.Blocked = allowed < speed speed = allowed end
        end
        if speed <= hum.WalkSpeed then return end -- a wall just stops you the normal way
        local v = hrp.AssemblyLinearVelocity
        hrp.AssemblyLinearVelocity = Vector3.new(dir.X * speed, v.Y, dir.Z * speed)
    end

    Track(RunService.Stepped:Connect(function() pcall(Step) end))

    -- Fly jump: jump again while in the air
    Track(UserInputService.JumpRequest:Connect(function()
        if not Movement.FlyJump or Unloaded then return end
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end) end
    end))
end

-- Shows your own anticheat score in the Movement tab
function Movement.UpdateScore(rows)
    local scores = {}
    for _, row in ipairs(rows) do
        if row.Player then scores[row.Player] = tonumber(row.Score) end
    end
    Movement.Scores = scores
    if not Movement.ScoreObj then return end
    for _, row in ipairs(rows) do
        if row.Player == LocalPlayer then
            local score = tonumber(row.Score)
            if score then
                Movement.ScoreObj:Set(string.format("AC score: %.1f", score))
                local last = Movement.LastScore
                if Movement.Alerts and last and math.abs(score - last) >= 0.05 then
                    local up = score > last
                    Notify(up and "AC points up" or "AC points down",
                        string.format("%s%.1f (now %.1f)", up and "+" or "", score - last, score), 2,
                        up and Color3.fromRGB(255, 58, 94) or Color3.fromRGB(173, 255, 115))
                end
                Movement.LastScore = score
            end
            return
        end
    end
    Movement.LastScore = nil
    Movement.ScoreObj:Set("AC score: not listed")
end

