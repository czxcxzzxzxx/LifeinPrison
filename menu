    -- Public server list for hopping
    local function fetchServers()
        local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100&excludeFullGames=true", game.PlaceId)
        local body
        local req = (typeof(request) == "function" and request) or (typeof(http_request) == "function" and http_request)
        if req then
            local ok, res = pcall(req, { Url = url, Method = "GET" })
            if ok and typeof(res) == "table" then body = res.Body end
        else
            local ok, res = pcall(function() return game:HttpGet(url) end)
            if ok then body = res end
        end
        if not body then return nil end
        local ok, data = pcall(HttpService.JSONDecode, HttpService, body)
        if not ok or typeof(data) ~= "table" or typeof(data.data) ~= "table" then return nil end
        local list = {}
        for _, sv in ipairs(data.data) do
            if sv.id ~= game.JobId and tonumber(sv.playing) and tonumber(sv.maxPlayers) and sv.playing < sv.maxPlayers then
                table.insert(list, sv)
            end
        end
        return list
    end

    local function hop(lowest)
        Notify("Server Hop", "Looking for a server...", 2)
        task.spawn(function()
            local list = fetchServers()
            if not list or #list == 0 then Notify("Server Hop", "No other server found", 3) return end
            local pick
            if lowest then
                table.sort(list, function(a, b) return a.playing < b.playing end)
                pick = list[1]
            else
                pick = list[math.random(#list)]
            end
            Notify("Server Hop", string.format("Joining a server with %d players", pick.playing), 3)
            task.wait(0.5)
            TeleportService:TeleportToPlaceInstance(game.PlaceId, pick.id, LocalPlayer)
        end)
    end
    misc:Button("Server Hop (random)", function() hop(false) end)
    misc:Button("Join Low Population Server", function() hop(true) end)

