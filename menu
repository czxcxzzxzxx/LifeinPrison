local function CheckFolder(path)
    if not IsFilesystemSupported then return false end
    if not isfolder(path) then
        if isfile(path) then delfile(path) end
        makefolder(path)
    end
    return true
end

local function ReadFileToTable(path)
    if not IsFilesystemSupported or not isfile(path) then return nil end
    local ok, content = pcall(readfile, path)
    if not ok or not content or #content == 0 then return nil end
    local ok2, result = pcall(HttpService.JSONDecode, HttpService, content)
    if not ok2 or not result then return nil end
    return result
end

local function WriteTableToFile(path, tabl)
    if not IsFilesystemSupported or typeof(tabl) ~= "table" then return false end
    if isfolder(path) and typeof(delfolder) == "function" then delfolder(path) end
    local ok, content = pcall(HttpService.JSONEncode, HttpService, tabl)
    if not ok or not content or #content == 0 then return false end
    return (pcall(writefile, path, content))
end

