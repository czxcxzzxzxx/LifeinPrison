local function OwnerLink_Post(path, tbl)
    if not HttpRequest or not RELAY_READY then return nil end
    local okEnc, bodyJson = pcall(HttpService.JSONEncode, HttpService, tbl)
    if not okEnc then return nil end
    local ok, res = pcall(HttpRequest, {
        Url = RELAY_URL .. path, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = bodyJson,
    })
    if not ok or typeof(res) ~= "table" then return nil end
    local code = res.StatusCode or res.Status
    if typeof(code) == "number" and (code < 200 or code >= 300) then return nil end
    local okDec, data = pcall(HttpService.JSONDecode, HttpService, res.Body or "")
    if okDec and typeof(data) == "table" then return data end
    return nil
end

