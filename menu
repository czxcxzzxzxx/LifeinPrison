-- Turret Wallbang (turret hits are decided by the client, so the hit table can be rewritten)
local Turret = { On = false, Part = "Head", Range = 400, TeamCheck = true, OriginalRemote = nil, RemotesRef = nil }

function Turret.Pick(origin)
    local best, bestChar, bestDist = nil, nil, math.min(Turret.Range, 400)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and not (Turret.TeamCheck and plr.Team ~= nil and plr.Team == LocalPlayer.Team) then
            local char = plr.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and not char:FindFirstChildOfClass("ForceField") then
                local part
                if Turret.Part == "Head" then
                    part = char:FindFirstChild("Head")
                else
                    part = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
                end
                if part then
                    local d = (part.Position - origin).Magnitude
                    if d < bestDist then best, bestChar, bestDist = part, char, d end
                end
            end
        end
    end
    return best
end

function Turret.Rewrite(bullets)
    if Unloaded or not Turret.On then return nil end
    if typeof(bullets) ~= "table" or #bullets == 0 then return nil end
    local first = bullets[1]
    if typeof(first) ~= "table" or typeof(first[1]) ~= "Vector3" then return nil end
    local target = Turret.Pick(first[1])
    if not target then return nil end
    local pos = target.Position
    local out = {}
    for i, b in ipairs(bullets) do
        out[i] = { b[1], b[2], pos, target, target.Position, target.CFrame:PointToObjectSpace(pos) }
    end
    return out
end

function Turret.Install(remotes, orig)
    local proxy = setmetatable({
        FireServer = function(_, seat, kind, a, b)
            if kind == 2 then
                local ok, new = pcall(Turret.Rewrite, a)
                if ok and new then a = new end
            end
            return orig:FireServer(seat, kind, a, b)
        end,
    }, { __index = function(_, k) return orig[k] end })
    remotes.Turret = proxy
    Turret.OriginalRemote, Turret.RemotesRef = orig, remotes
end

function Turret.Restore()
    local remotes, orig = Turret.RemotesRef, Turret.OriginalRemote
    if not (remotes and orig) then return end
    pcall(function()
        local frozen = table.isfrozen and table.isfrozen(remotes)
        if frozen and setreadonly then setreadonly(remotes, false) end
        remotes.Turret = orig
        if frozen and setreadonly then setreadonly(remotes, true) end
    end)
    Turret.OriginalRemote, Turret.RemotesRef = nil, nil
end

-- Silent Aim
local Silent = {
    S = { Enabled = false, FOV = 150, ShowFOV = true, HitChance = 100, Part = "Head", TeamCheck = true,
          WallCheck = true, MaxDistance = 1500, Origin = "Mouse" },
    ButtonRefresh = nil, Gui = nil, Circle = nil, OriginalRemote = nil, RemotesRef = nil, Forced = nil,
}

do
    local S = Silent.S
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.IgnoreWater = true

    local function GetPart(char)
        local mode = S.Part
        if mode == "Random" then mode = (math.random() < 0.4) and "Head" or "Torso" end
        if mode == "Head" then return char:FindFirstChild("Head") end
        return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    end

    local function IsVisible(part, char, fromPos)
        local me = LocalPlayer.Character
        rayParams.FilterDescendantsInstances = me and { me } or {}
        local hit = workspace:Raycast(fromPos, part.Position - fromPos, rayParams)
        return hit == nil or hit.Instance:IsDescendantOf(char)
    end

    -- Centre of the FOV: the middle of the screen (Camera) or your cursor (Mouse)
    function Silent.Origin()
        local cam = workspace.CurrentCamera
        local size = cam and cam.ViewportSize or Vector2.new(1280, 720)
        if S.Origin == "Mouse" and UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
            return UserInputService:GetMouseLocation()
        end
        return Vector2.new(size.X / 2, size.Y / 2)
    end

    -- Pick the closest target inside the FOV
    local function FindTarget(origin)
        local cam = workspace.CurrentCamera
        if not cam then return nil end
        local centre = Silent.Origin()
        local best, bestChar, bestDist = nil, nil, S.FOV
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and not (S.TeamCheck and plr.Team ~= nil and plr.Team == LocalPlayer.Team) then
                local char = plr.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 and not char:FindFirstChildOfClass("ForceField") then
                    local part = GetPart(char)
                    if part then
                        local sp, onScreen = cam:WorldToViewportPoint(part.Position)
                        if onScreen and sp.Z > 0 and (part.Position - origin).Magnitude <= S.MaxDistance then
                            local d = (Vector2.new(sp.X, sp.Y) - centre).Magnitude
                            if d < bestDist and (not S.WallCheck or IsVisible(part, char, origin)) then
                                best, bestChar, bestDist = part, char, d
                            end
                        end
                    end
                end
            end
        end
        return best, bestChar
    end

    local function IsExplosiveTool(tool)
        local n = typeof(tool) == "Instance" and string.lower(tool.Name) or ""
        for _, k in ipairs({ "rpg", "launcher", "rocket", "bazooka" }) do
            if string.find(n, k, 1, true) then return true end
        end
        return false
    end

    -- Ray check from the shot origin to the target
    local function RayToTarget(origin, part, char)
        local me = LocalPlayer.Character
        rayParams.FilterDescendantsInstances = me and { me } or {}
        local dir = part.Position - origin
        if dir.Magnitude < 0.1 or dir.Magnitude > S.MaxDistance then return nil end
        local hit = workspace:Raycast(origin, dir.Unit * (dir.Magnitude + 3), rayParams)
        if hit and hit.Instance:IsDescendantOf(char) then return hit end
        return nil
    end

    -- Build the rewritten bullets table
    function Silent.Rewrite(tool, bullets)
        if Unloaded then return nil end
        local forced = Silent.Forced
        if forced and not forced.Parent then forced = nil end
        if not S.Enabled and not forced then return nil end
        if typeof(bullets) ~= "table" or #bullets == 0 or IsExplosiveTool(tool) then return nil end
        local first = bullets[1]
        if typeof(first) ~= "table" or typeof(first[1]) ~= "Vector3" then return nil end
        local origin = first[1]
        local target, char
        if forced then target, char = forced:FindFirstChild("Head"), forced end
        if not target then
            if not S.Enabled then return nil end
            if S.HitChance < 100 and math.random() * 100 > S.HitChance then return nil end
            target, char = FindTarget(origin)
        end
        if not target then return nil end
        local hit = RayToTarget(origin, target, char)
        if not hit then return nil end
        local inst = hit.Instance
        local out = {}
        for i, b in ipairs(bullets) do
            out[i] = { b[1], b[2], hit.Position, inst, inst.Position, inst.CFrame:PointToObjectSpace(hit.Position) }
        end
        return out
    end

    -- Wrap the FirearmBullets remote
    function Silent.Install(remotes, orig)
        local proxy = setmetatable({
            FireServer = function(_, tool, bullets, stamp)
                local ok, newBullets = pcall(Silent.Rewrite, tool, bullets)
                return orig:FireServer(tool, (ok and newBullets) or bullets, stamp)
            end,
        }, { __index = function(_, k) return orig[k] end })
        remotes.FirearmBullets = proxy
        Silent.OriginalRemote, Silent.RemotesRef = orig, remotes
    end

    function Silent.Restore()
        local remotes, orig = Silent.RemotesRef, Silent.OriginalRemote
        if not (remotes and orig) then return end
        pcall(function()
            local frozen = table.isfrozen and table.isfrozen(remotes)
            if frozen and setreadonly then setreadonly(remotes, false) end
            remotes.FirearmBullets = orig
            if frozen and setreadonly then setreadonly(remotes, true) end
        end)
        Silent.OriginalRemote, Silent.RemotesRef = nil, nil
    end

    function Silent.RefreshCircle()
        local c = Silent.Circle
        if not c then return end
        c.Size = UDim2.fromOffset(S.FOV * 2, S.FOV * 2)
        c.Visible = S.ShowFOV and S.Enabled
        Silent.UpdateCircle()
    end

    -- Keeps the circle on the cursor (Mouse) or the screen centre (Camera)
    function Silent.UpdateCircle()
        local c = Silent.Circle
        if not c then return end
        local o = Silent.Origin()
        c.Position = UDim2.fromOffset(o.X, o.Y)
        -- team colour, like the Lock circle
        if Silent.Stroke then
            local team = LocalPlayer.Team
            Silent.Stroke.Color = team and team.TeamColor.Color or Color3.new(1, 1, 1)
        end
    end

    function Silent.SetEnabled(state, quiet)
        S.Enabled = state and true or false
        Silent.RefreshCircle()
        if Silent.ButtonRefresh then Silent.ButtonRefresh() end
        if not quiet then Notify("Silent Aim", S.Enabled and "Enabled" or "Disabled", 2) end
    end

    function Silent.CreateCircle()
        local ok, parent = pcall(function() return (typeof(gethui) == "function" and gethui()) or cloneref(game:GetService("CoreGui")) end)
        if not ok or not parent then parent = LocalPlayer:WaitForChild("PlayerGui") end
        local gui = Instance.new("ScreenGui")
        gui.Name = "LIPMenu_SilentFOV"
        gui.ResetOnSpawn = false
        gui.IgnoreGuiInset = true
        gui.DisplayOrder = 998
        gui.Parent = parent
        local circle = Instance.new("Frame")
        circle.AnchorPoint = Vector2.new(0.5, 0.5)
        circle.Position = UDim2.fromScale(0.5, 0.5)
        circle.BackgroundTransparency = 1
        circle.Active = false
        circle.Parent = gui
        Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)
        local stroke = Instance.new("UIStroke", circle)
        stroke.Thickness = 1.5
        stroke.Color = Color3.new(1, 1, 1)
        stroke.Transparency = 0.45
        Silent.Gui, Silent.Circle, Silent.Stroke = gui, circle, stroke
        Silent.RefreshCircle()
    end
end

