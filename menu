local function OnCharacterAdded(char)
    -- Gun mods
    local itemCallbacks = GetActiveItemReceiveCallbacks()
    local fnFirearmCallback = itemCallbacks and itemCallbacks.Firearm
    if typeof(fnFirearmCallback) == "function" then
        local origFirearm
        origFirearm = hookfunction(fnFirearmCallback, newcclosure(function(toolTable, gunStats)
            if Unloaded or not CheatDT.GunModsEnabled or typeof(toolTable) ~= "table" or typeof(gunStats) ~= "table"
                or not toolTable.Tool or not toolTable.Tool:IsA("Tool")
                or not (toolTable.Tool.Parent == LocalPlayer.Backpack or toolTable.Tool:IsDescendantOf(char)) then
                return origFirearm(toolTable, gunStats)
            end

            local filterCheck = CheatDT.GunModsUsePresetInstead or not CheatDT.GunsModsFilterName
            if not filterCheck then
                for _, v in ipairs(string.split(CheatDT.GunsModsFilterName, ";")) do
                    if string.lower(toolTable.Tool.Name) == string.lower(v) then filterCheck = true break end
                end
            end

            if filterCheck then
                local statsTable
                if CheatDT.GunModsUsePresetInstead and CheatDT.GunModsPreset then
                    local perGun = CheatDT.GunModsPreset[toolTable.Tool.Name]
                    if typeof(perGun) == "table" then
                        statsTable = perGun
                    elseif CheatDT.GunModsPreset.UseDefaultTable then
                        statsTable = CheatDT.GunModsPreset.DefaultTable
                    end
                end
                gunStats.magammo = statsTable and statsTable.MagAmmo or CheatDT.GunModsMagammo
                gunStats.firerate = statsTable and statsTable.FireRate or CheatDT.GunModsFirerate
                gunStats.spread = 0
                if not gunStats.isauto and CheatDT.GunModsAutomatize then gunStats.isauto = true end
                if CheatDT.GunModsRemoveNegativeEffects then
                    for _, key in ipairs({ "wseffect", "jpeffect", "aimwseffect", "aimjpeffect" }) do
                        if typeof(gunStats[key]) == "number" and gunStats[key] < 0 then gunStats[key] = nil end
                    end
                end
            end
            return origFirearm(toolTable, gunStats)
        end))
    end
end

local function AC_GetConnections(signal)
    local result = {}
    for _, v in ipairs(getconnections(signal)) do
        local fn = v.Function
        if fn and not iscclosure(fn) then
            local ok, info = pcall(debug.getinfo, fn)
            if ok and info and info.source and string.find(info.source, "BClient", 1, true) then
                table.insert(result, v)
            end
        end
    end
    return result
end

