        local results = make("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 74), Size = UDim2.new(1, 0, 0, 328), Visible = false }, win)

        local function has(path)
            local env = (typeof(getgenv) == "function" and getgenv()) or _G
            local cur = env
            for part in string.gmatch(path, "[^%.]+") do
                if typeof(cur) ~= "table" then return false end
                local ok, v = pcall(function() return cur[part] end)
                if not ok then return false end
                cur = v
            end
            return typeof(cur) == "function"
        end
        local function hasAny(paths)
            for _, p in ipairs(paths) do if has(p) then return true end end
            return false
        end

