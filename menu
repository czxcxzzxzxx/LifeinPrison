-- Aim
local function GetAimOrigin()
    if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
        return workspace.CurrentCamera.ViewportSize / 2
    end
    return UserInputService:GetMouseLocation()
end

local NEAREST_PARTS = {
    "Head", "UpperTorso", "Torso", "HumanoidRootPart", "LowerTorso",
    "LeftUpperArm", "RightUpperArm", "Left Arm", "Right Arm",
    "LeftUpperLeg", "RightUpperLeg", "Left Leg", "Right Leg",
}

local function FirstChildOf(char, names)
    for _, n in ipairs(names) do
        local p = char:FindFirstChild(n)
        if p and p:IsA("BasePart") then return p end
    end
    return nil
end

local function GetAimCandidates(char)
    local mode = AimSettings.AimPart
    if mode == "Head" then
        local p = FirstChildOf(char, { "Head" })
        return p and { p } or {}
    elseif mode == "Nearest" then
        local list = {}
        for _, n in ipairs(NEAREST_PARTS) do
            local p = char:FindFirstChild(n)
            if p and p:IsA("BasePart") then table.insert(list, p) end
        end
        return list
    end
    local p = FirstChildOf(char, { "UpperTorso", "Torso", "HumanoidRootPart" })
    return p and { p } or {}
end

local AimState = { part = nil, lastPos = nil, vel = Vector3.zero }
local AimRay = RaycastParams.new()
AimRay.FilterType = Enum.RaycastFilterType.Exclude
AimRay.IgnoreWater = true
AimRay.RespectCanCollide = true

local function AimVisible(cam, part, char)
    local from = cam.CFrame.Position
    local filter = { LocalPlayer.Character, cam }
    for _ = 1, 4 do
        AimRay.FilterDescendantsInstances = filter
        local result = workspace:Raycast(from, part.Position - from, AimRay)
        if not result then return true end
        local hit = result.Instance
        if hit:IsDescendantOf(char) then return true end
        local model = hit:FindFirstAncestorOfClass("Model")
        if model and model:FindFirstChildOfClass("Humanoid") then
            table.insert(filter, model)
        else
            return false
        end
    end
    return false
end

local function GetClosestAimPart()
    local cam = workspace.CurrentCamera
    local origin = GetAimOrigin()
    local best, bestScore = nil, math.huge
    local fov = AimSettings.FOV

    for _, player in ipairs(Players:GetPlayers()) do
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local skip = player == LocalPlayer or not hum or hum.Health <= 0
            or (AimSettings.TeamCheck and player.Team ~= nil and player.Team == LocalPlayer.Team)
            or (char and char:FindFirstChildOfClass("ForceField") ~= nil)

        for _, part in ipairs(skip and {} or GetAimCandidates(char)) do
            local sp, onScreen = cam:WorldToViewportPoint(part.Position)
            if onScreen and sp.Z > 0 then
                local dist = (Vector2.new(sp.X, sp.Y) - origin).Magnitude
                local sticky = part == AimState.part
                local limit = sticky and fov * 1.3 or fov
                local score = sticky and dist * 0.6 or dist
                if dist <= limit and score < bestScore then
                    if not AimSettings.WallCheck or AimVisible(cam, part, char) then
                        best, bestScore = part, score
                    end
                end
            end
        end
    end
    return best
end

local function GetPredictedPos(part, dt)
    local pos = part.Position
    if AimState.part ~= part or not AimState.lastPos then
        AimState.part, AimState.lastPos, AimState.vel = part, pos, Vector3.zero
        return pos
    end
    if dt > 0 then
        local raw = (pos - AimState.lastPos) / dt
        if raw.Magnitude > 150 then
            AimState.vel = Vector3.zero
        else
            AimState.vel = AimState.vel:Lerp(raw, 0.35)
        end
    end
    AimState.lastPos = pos
    if not AimSettings.Prediction then return pos end
    local lead = math.clamp(LocalPlayer:GetNetworkPing(), 0, 0.3) * 0.5 + 0.03
    return pos + AimState.vel * lead
end

local function AimAlpha(dt)
    local smooth = math.max(AimSettings.Smoothness, 1)
    if smooth <= 1 then return 1 end
    return 1 - math.pow(1 - 1 / smooth, math.clamp(dt, 0, 0.1) * 60)
end

local function AimAt(pos, dt)
    local cam = workspace.CurrentCamera
    local alpha = AimAlpha(dt)

    if AimSettings.Method == "Mouse" and mousemoverel then
        local sp, onScreen = cam:WorldToViewportPoint(pos)
        if onScreen and sp.Z > 0 then
            local o = GetAimOrigin()
            mousemoverel((sp.X - o.X) * alpha, (sp.Y - o.Y) * alpha)
        end
        return
    end

    local from = cam.CFrame.Position
    local dir = pos - from
    if dir.Magnitude < 1 or math.abs(dir.Unit.Y) > 0.999 then return end
    cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(from, pos), alpha)
end

local function SetAim(state, silent)
    AimSettings.Enabled = state
    if FOVCircle then FOVCircle.Visible = state end
    if not silent then Notify("Mouse Lock", state and "Enabled" or "Disabled", 2) end
end

-- Runs after the camera update
local function AimStep(dt)
    if Unloaded then return end
    local part = AimSettings.Enabled and GetClosestAimPart() or nil
    if not part and LoopSettings.SpinEnabled and LoopSettings.LockPart and LoopSettings.LockPart.Parent then
        part = LoopSettings.LockPart
    end
    if part then
        AimAt(GetPredictedPos(part, dt), dt)
    else
        AimState.part, AimState.lastPos = nil, nil
    end
end

RunService:BindToRenderStep("LIPMenu_Aim", Enum.RenderPriority.Camera.Value + 1, AimStep)

