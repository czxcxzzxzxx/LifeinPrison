-- Music: plays audio files from the workspace folder through the executor (no Roblox asset ids)
local Music = {
    Dir = CHEAT_DIR .. "/Music", Sound = nil, Files = {}, Current = nil, Conn = nil,
    Volume = 1, Loop = false, Shuffle = false, Autoplay = true,
}
local SoundService = cloneref(game:GetService("SoundService"))

function Music.Supported()
    return IsFilesystemSupported and typeof(listfiles) == "function" and (typeof(getcustomasset) == "function" or typeof(getsynasset) == "function")
end

function Music.Scan()
    local names = {}
    if Music.Supported() then
        CheckFolder(CHEAT_DIR)
        CheckFolder(Music.Dir)
        local ok, paths = pcall(listfiles, Music.Dir)
        if ok and typeof(paths) == "table" then
            for _, path in ipairs(paths) do
                local name = string.match(tostring(path), "([^/\\]+)$")
                local ext = name and string.lower(string.match(name, "%.(%w+)$") or "")
                if name and (ext == "mp3" or ext == "ogg") then table.insert(names, name) end
            end
        end
    end
    table.sort(names, function(a, b) return string.lower(a) < string.lower(b) end)
    Music.Files = names
    return names
end

function Music.Stop()
    if Music.Conn then Music.Conn:Disconnect() Music.Conn = nil end
    if Music.Sound then pcall(function() Music.Sound:Stop() Music.Sound:Destroy() end) Music.Sound = nil end
    Music.Current = nil
end

function Music.Play(name)
    if not name or not Music.Supported() then return false end
    local path = Music.Dir .. "/" .. name
    if not isfile(path) then Notify("Music", name .. " not found", 3) return false end
    Music.Stop()
    local getAsset = getcustomasset or getsynasset
    local ok, asset = pcall(getAsset, path)
    if not ok or not asset then Notify("Music", "Could not load " .. name, 3) return false end
    local sound = Instance.new("Sound")
    sound.Name = "LIPMusic"
    sound.SoundId = asset
    sound.Volume = Music.Volume
    sound.Looped = Music.Loop
    sound.Parent = SoundService
    Music.Sound, Music.Current = sound, name
    sound:Play()
    Music.Conn = sound.Ended:Connect(function()
        if Music.Autoplay and not Music.Loop then Music.Next() else Music.Stop() end
    end)
    return true
end

function Music.Next(step)
    local files = Music.Files
    if #files == 0 then Music.Stop() return end
    local idx = table.find(files, Music.Current) or 0
    if Music.Shuffle and #files > 1 then
        local nxt = idx
        while nxt == idx do nxt = math.random(#files) end
        idx = nxt
    else
        idx = ((idx - 1 + (step or 1)) % #files) + 1
    end
    Music.Play(files[idx])
end

function Music.Download(url)
    local req = (typeof(request) == "function" and request) or (typeof(http_request) == "function" and http_request)
    if not req then return nil, "no request function" end
    local clean = string.match(url, "^[^?#]+") or url
    local name = string.match(clean, "([^/]+)$") or ("track" .. os.time())
    name = string.gsub(name, "[^%w%._%- ]", "_")
    local ext = string.lower(string.match(name, "%.(%w+)$") or "")
    if ext ~= "mp3" and ext ~= "ogg" then name = name .. ".mp3" end
    local ok, res = pcall(req, { Url = url, Method = "GET" })
    if not ok or typeof(res) ~= "table" or res.StatusCode ~= 200 or typeof(res.Body) ~= "string" or #res.Body < 1000 then
        return nil, "download failed"
    end
    CheckFolder(CHEAT_DIR)
    CheckFolder(Music.Dir)
    if not pcall(writefile, Music.Dir .. "/" .. name, res.Body) then return nil, "could not save the file" end
    return name
end

local Rainbow = { On = false, Speed = 3, Rec = {}, List = {}, Next = 0 }

local function RainbowRestoreOne(inst, r)
    pcall(function()
        if r.k == "part" then
            inst.Color = r.color
            if r.tex ~= nil then inst.TextureID = r.tex end
        elseif r.k == "sa" then
            inst.Parent = r.parent
        elseif r.k == "mesh" then
            inst.TextureId = r.tex
        elseif r.k == "decal" then
            inst.Color3 = r.color
        end
    end)
end

function Rainbow.Restore()
    for inst, r in pairs(Rainbow.Rec) do
        RainbowRestoreOne(inst, r)
        Rainbow.Rec[inst] = nil
    end
    Rainbow.List = {}
end

local function RainbowCollect()
    local list = {}

    local function take(inst)
        if Rainbow.Rec[inst] then
            list[#list + 1] = inst
            return
        end
        local r
        if inst:IsA("SurfaceAppearance") then
            r = { k = "sa", parent = inst.Parent }
            Rainbow.Rec[inst] = r
            pcall(function() inst.Parent = nil end)
            return
        elseif inst:IsA("BasePart") then
            r = { k = "part", color = inst.Color }
            if inst:IsA("MeshPart") then
                r.tex = inst.TextureID
                if r.tex ~= "" then pcall(function() inst.TextureID = "" end) end
            end
        elseif inst:IsA("SpecialMesh") then
            r = { k = "mesh", tex = inst.TextureId }
            if r.tex ~= "" then pcall(function() inst.TextureId = "" end) end
        elseif inst:IsA("Decal") or inst:IsA("Texture") then
            r = { k = "decal", color = inst.Color3 }
        else
            return
        end
        Rainbow.Rec[inst] = r
        list[#list + 1] = inst
    end
    for _, holder in ipairs({ LocalPlayer.Character, LocalPlayer:FindFirstChildOfClass("Backpack") }) do
        if holder then
            for _, tool in ipairs(holder:GetChildren()) do
                if tool:IsA("Tool") then
                    for _, d in ipairs(tool:GetDescendants()) do take(d) end
                end
            end
        end
    end
    -- forget parts that no longer exist
    for inst, r in pairs(Rainbow.Rec) do
        if r.k ~= "sa" and not inst.Parent then Rainbow.Rec[inst] = nil end
    end
    return list
end

Track(RunService.Heartbeat:Connect(function()
    if not Rainbow.On or Unloaded then return end
    local now = tick()
    if now >= Rainbow.Next then
        Rainbow.Next = now + 0.4
        Rainbow.List = RainbowCollect()
    end
    local c = Color3.fromHSV((now * Rainbow.Speed * 0.1) % 1, 1, 1)
    for _, inst in ipairs(Rainbow.List) do
        if inst.Parent then
            if inst:IsA("BasePart") then inst.Color = c elseif inst:IsA("Decal") or inst:IsA("Texture") then inst.Color3 = c end
        end
    end
end))

