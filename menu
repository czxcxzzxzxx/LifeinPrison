local VoidTP = { Enabled = false, Hold = 1.1 }

local function VoidHold(root, x, z)
    local char = root.Parent
    local was = root.Anchored
    root.AssemblyLinearVelocity = Vector3.zero
    root.CFrame = CFrame.new(x, workspace.FallenPartsDestroyHeight + 60, z)
    root.Anchored = true
    local t0 = os.clock()
    while os.clock() - t0 < VoidTP.Hold do
        if not root.Parent or LocalPlayer.Character ~= char then return end
        RunService.Heartbeat:Wait()
    end
    root.Anchored = was
end

local function TeleportToCords(cords)
    local hrp = GetRoot(LocalPlayer.Character)
    if not hrp then return end
    if VoidTP.Enabled then
        VoidHold(hrp, cords.X, cords.Z)
    end
    hrp = GetRoot(LocalPlayer.Character)
    if not hrp then return end
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    hrp.CFrame = CFrame.new(cords)
end

