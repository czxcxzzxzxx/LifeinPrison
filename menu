    g.DisplayOrder = 998
    g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    local ok = pcall(function() g.Parent = (typeof(gethui) == "function" and gethui()) or cloneref(game:GetService("CoreGui")) end)
    if not ok then g.Parent = LocalPlayer:WaitForChild("PlayerGui") end
    GuiDraw.Gui = g
    return g
end

local function GuiDrawNew(class)
    local st = {
        Visible = false, Color = Color3.new(1, 1, 1), Thickness = 1, Filled = false, Transparency = 1, Radius = 100, NumSides = 64,
        Size = class == "Text" and 13 or Vector2.zero, Position = Vector2.zero, Text = "", Center = false, Outline = false,
        From = Vector2.zero, To = Vector2.zero,
    }
    local inst, stroke
    if class == "Text" then
        inst = Instance.new("TextLabel")
        inst.BackgroundTransparency = 1
        inst.Font = Enum.Font.Code
        inst.TextWrapped = false
    else
        inst = Instance.new("Frame")
        inst.BorderSizePixel = 0
        inst.BackgroundTransparency = 1
        if class == "Square" or class == "Circle" then
            stroke = Instance.new("UIStroke")
            stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            stroke.Parent = inst
        end
        if class == "Circle" then
            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(1, 0)
            corner.Parent = inst
        end
    end
    inst.Visible = false
    inst.Parent = GuiDrawRoot()

    local function render()
        inst.Visible = st.Visible
        if not st.Visible then return end
        local alpha = 1 - st.Transparency
        if class == "Square" or class == "Circle" then
            if class == "Circle" then
                inst.AnchorPoint = Vector2.new(0.5, 0.5)
                inst.Size = UDim2.fromOffset(st.Radius * 2, st.Radius * 2)
            else
                inst.AnchorPoint = Vector2.zero
                inst.Size = UDim2.fromOffset(st.Size.X, st.Size.Y)
            end
            inst.Position = UDim2.fromOffset(st.Position.X, st.Position.Y)
            if st.Filled then
                inst.BackgroundColor3 = st.Color
                inst.BackgroundTransparency = alpha
                stroke.Enabled = false
            else
                inst.BackgroundTransparency = 1
                stroke.Enabled = true
                stroke.Color = st.Color
                stroke.Thickness = st.Thickness
                stroke.Transparency = alpha
            end
        elseif class == "Text" then
            inst.Text = st.Text
            inst.TextSize = st.Size
            inst.TextColor3 = st.Color
            inst.TextTransparency = alpha
            inst.TextStrokeTransparency = st.Outline and 0 or 1
            inst.Size = UDim2.fromOffset(240, st.Size + 4)
            inst.Position = UDim2.fromOffset(st.Position.X, st.Position.Y)
            inst.AnchorPoint = st.Center and Vector2.new(0.5, 0) or Vector2.zero
            inst.TextXAlignment = st.Center and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left
        else
            local dx, dy = st.To.X - st.From.X, st.To.Y - st.From.Y
            inst.AnchorPoint = Vector2.new(0.5, 0.5)
            inst.Position = UDim2.fromOffset((st.From.X + st.To.X) / 2, (st.From.Y + st.To.Y) / 2)
            inst.Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy), math.max(st.Thickness, 1))
            inst.Rotation = math.deg(math.atan2(dy, dx))
            inst.BackgroundColor3 = st.Color
            inst.BackgroundTransparency = alpha
        end
    end

    local proxy = {}
    function proxy.Remove() pcall(function() inst:Destroy() end) end
    return setmetatable(proxy, {
        __index = function(_, k) return st[k] end,
        __newindex = function(_, k, v)
            if st[k] == v then return end
            st[k] = v
            render()
        end,
    })
end

