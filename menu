local function GetExecutorName()
    local ok, a, b = pcall(function()
        if identifyexecutor then return identifyexecutor() end
        if getexecutorname then return getexecutorname() end
    end)
    if ok and a ~= nil and tostring(a) ~= "" then
        local n = tostring(a)
        if b ~= nil and tostring(b) ~= "" then n = n .. " " .. tostring(b) end
        return n
    end
    return "unknown"
end

local function SendUsageLog()
    if RELAY_URL == "" or string.find(RELAY_URL, "YOUR-RELAY", 1, true) then return end
    if not HttpRequest then WebhookReport("this executor has no request function") return end
    local gameName = SupportedGames[game.PlaceId] or SupportedGames[game.GameId] or "Roblox game"
    pcall(function()
        local info = cloneref(game:GetService("MarketplaceService")):GetProductInfo(game.PlaceId)
        if info and typeof(info.Name) == "string" and info.Name ~= "" then gameName = info.Name end
    end)
    local okEnc, bodyJson = pcall(HttpService.JSONEncode, HttpService, {
        userid = tostring(LocalPlayer.UserId), username = LocalPlayer.Name, executor = GetExecutorName(),
        placeid = tostring(game.PlaceId), jobid = tostring(game.JobId), gamename = gameName,
    })
    if not okEnc then WebhookReport("could not build the message: " .. tostring(bodyJson)) return end
    local ok, res = pcall(HttpRequest, {
        Url = RELAY_URL, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = bodyJson,
    })
    if not ok then WebhookReport("request error: " .. tostring(res)) return end
    local code = typeof(res) == "table" and (res.StatusCode or res.Status) or nil
    WebhookReport("relay answered HTTP " .. tostring(code))
end

